{
  "headers": [
    {
      "source": "/cv/download",
      "headers": [
        { "key": "Content-Type", "value": "application/pdf" },
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"Muhammad-Umar-Ramadhana-CV.pdf\""
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/cv/download", "destination": "/docs_data/data-umar-v7.pdf" },
    { "source": "/((?!.*\\.).*)", "destination": "/index.html" }
  ]
}
